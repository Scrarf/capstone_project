* MULTISINE: 50-tone multisine for EIT front-end simulation
* V(p,n) = A * sum_{k=1..50} sin(2*pi*f_k*t + phi_k)
*   f_k   = k * 10 kHz  (10 ... 500 kHz)
*   phi_k = -pi*k*(k-1)/50  (Schroeder phases, low crest factor)
* A = amplitude of EACH tone. A=0.031368 -> 0.3 V peak, A=0.94105 -> 9 V peak
* Pins: p (pin 1), n (pin 2)
.subckt MULTISINE p n A=0.031368
B1 p n V = {A}*(
+  sin(6.283185307e+04*time-0.000000000)   ; 10 kHz
+ +sin(1.256637061e+05*time-0.125663706)   ; 20 kHz
+ +sin(1.884955592e+05*time-0.376991118)   ; 30 kHz
+ +sin(2.513274123e+05*time-0.753982237)   ; 40 kHz
+ +sin(3.141592654e+05*time-1.256637061)   ; 50 kHz
+ +sin(3.769911184e+05*time-1.884955592)   ; 60 kHz
+ +sin(4.398229715e+05*time-2.638937829)   ; 70 kHz
+ +sin(5.026548246e+05*time-3.518583772)   ; 80 kHz
+ +sin(5.654866776e+05*time-4.523893421)   ; 90 kHz
+ +sin(6.283185307e+05*time-5.654866776)   ; 100 kHz
+ +sin(6.911503838e+05*time-6.911503838)   ; 110 kHz
+ +sin(7.539822369e+05*time-8.293804605)   ; 120 kHz
+ +sin(8.168140899e+05*time-9.801769079)   ; 130 kHz
+ +sin(8.796459430e+05*time-11.435397259)   ; 140 kHz
+ +sin(9.424777961e+05*time-13.194689145)   ; 150 kHz
+ +sin(1.005309649e+06*time-15.079644737)   ; 160 kHz
+ +sin(1.068141502e+06*time-17.090264036)   ; 170 kHz
+ +sin(1.130973355e+06*time-19.226547040)   ; 180 kHz
+ +sin(1.193805208e+06*time-21.488493751)   ; 190 kHz
+ +sin(1.256637061e+06*time-23.876104167)   ; 200 kHz
+ +sin(1.319468915e+06*time-26.389378290)   ; 210 kHz
+ +sin(1.382300768e+06*time-29.028316119)   ; 220 kHz
+ +sin(1.445132621e+06*time-31.792917654)   ; 230 kHz
+ +sin(1.507964474e+06*time-34.683182896)   ; 240 kHz
+ +sin(1.570796327e+06*time-37.699111843)   ; 250 kHz
+ +sin(1.633628180e+06*time-40.840704497)   ; 260 kHz
+ +sin(1.696460033e+06*time-44.107960856)   ; 270 kHz
+ +sin(1.759291886e+06*time-47.500880922)   ; 280 kHz
+ +sin(1.822123739e+06*time-51.019464694)   ; 290 kHz
+ +sin(1.884955592e+06*time-54.663712172)   ; 300 kHz
+ +sin(1.947787445e+06*time-58.433623357)   ; 310 kHz
+ +sin(2.010619298e+06*time-62.329198247)   ; 320 kHz
+ +sin(2.073451151e+06*time-66.350436844)   ; 330 kHz
+ +sin(2.136283004e+06*time-70.497339147)   ; 340 kHz
+ +sin(2.199114858e+06*time-74.769905155)   ; 350 kHz
+ +sin(2.261946711e+06*time-79.168134870)   ; 360 kHz
+ +sin(2.324778564e+06*time-83.692028292)   ; 370 kHz
+ +sin(2.387610417e+06*time-88.341585419)   ; 380 kHz
+ +sin(2.450442270e+06*time-93.116806252)   ; 390 kHz
+ +sin(2.513274123e+06*time-98.017690792)   ; 400 kHz
+ +sin(2.576105976e+06*time-103.044239038)   ; 410 kHz
+ +sin(2.638937829e+06*time-108.196450990)   ; 420 kHz
+ +sin(2.701769682e+06*time-113.474326648)   ; 430 kHz
+ +sin(2.764601535e+06*time-118.877866012)   ; 440 kHz
+ +sin(2.827433388e+06*time-124.407069082)   ; 450 kHz
+ +sin(2.890265241e+06*time-130.061935859)   ; 460 kHz
+ +sin(2.953097094e+06*time-135.842466341)   ; 470 kHz
+ +sin(3.015928947e+06*time-141.748660530)   ; 480 kHz
+ +sin(3.078760801e+06*time-147.780518425)   ; 490 kHz
+ +sin(3.141592654e+06*time-153.938040026)   ; 500 kHz
+ )
.ends MULTISINE
